# Main XMPP domain, e.g. xmpp.example.org
XMPP_DOMAIN=xmpp.example.org
XMPP_ADMIN_USER=admin
XMPP_ADMIN_PASSWORD=CHANGE_ME

# HTTP Basic Auth in front of /admin
ADMIN_HTTP_USER=admin
ADMIN_HTTP_PASSWORD=CHANGE_ME
ADMIN_HTPASSWD_FILE=/etc/nginx/.htpasswd-xmpp-admin

# PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME

# Let's Encrypt / certbot
LE_CERT_NAME=xmpp.example.org
LE_EMAIL=admin@example.org
CERT_SOURCE_DIR=/var/lib/xmpp-portainer-stack/certs

# coturn
TURN_SECRET=CHANGE_ME
TURN_LISTEN_IP=192.168.1.54
TURN_RELAY_IP=192.168.1.54
TURN_EXTERNAL_IP=203.0.113.10
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_CONFIG_FILE=/var/lib/xmpp-portainer-stack/turnserver.conf
