# Required. Point these DNS A/AAAA records to the Docker host:
# xmpp.example.org, conference.xmpp.example.org, share.xmpp.example.org,
# turn.xmpp.example.org (TURN uses port 3478, not HTTPS).
XMPP_DOMAIN=xmpp.example.org
ACME_EMAIL=admin@example.org
XMPP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Optional settings
XMPP_ADMIN_USER=admin
ADMIN_HTTP_USER=admin
# Assets ref from the public repo: main, a release tag, or a commit SHA.
ASSETS_REF=main

# If coturn is behind NAT, supply public and private relay addresses.
# Leave blank when Docker host itself has a public IP.
TURN_EXTERNAL_IP=
TURN_RELAY_IP=
