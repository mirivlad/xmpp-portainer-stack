ground-clip:text;color:transparent}.hero p{font-size:1.16rem;color:#b0bfd0;max-width:690px;margin:0}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.btn{display:inline-flex;align-items:center;gap:9px;padding:13px 18px;border-radius:12px;background:linear-gradient(135deg,#7addff,#8ca5ff);color:#071019!important;text-decoration:none;font-weight:850;box-shadow:0 12px 35px rgba(85,170,255,.18);transition:.18s transform,.18s box-shadow}.btn:hover{transform:translateY(-2px);box-shadow:0 16px 42px rgba(85,170,255,.27)}.btn.secondary{background:rgba(16,24,35,.72);border:1px solid var(--line);color:#eaf5ff!important;box-shadow:none}.node{position:relative;min-height:360px;display:grid;place-items:center}.orb{width:210px;height:210px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 35% 30%,#233a55,#111827 48%,#090d13 70%);border:1px solid rgba(123,207,255,.28);box-shadow:0 0 0 28px rgba(100,180,255,.025),0 0 0 62px rgba(100,180,255,.018),0 28px 80px rgba(0,0,0,.55);font:800 1.1rem ui-monospace,SFMono-Regular,Consolas,monospace;color:#cbeaff}.orb:before,.orb:after{content:"";position:absolute;border:1px solid rgba(120,205,255,.18);border-radius:50%;animation:spin 16s linear infinite}.orb:before{width:295px;height:145px}.orb:after{width:150px;height:315px;animation-direction:reverse;animation-duration:21s}.sat{position:absolute;padding:7px 10px;border-radius:9px;border:1px solid var(--line);background:rgba(10,16,24,.84);font:700 .72rem ui-monospace,SFMono-Regular,Consolas,monospace;color:#a9c9e4;backdrop-filter:blur(10px)}.s1{top:35px;left:18px}.s2{right:10px;top:100px}.s3{left:0;bottom:65px}.s4{right:48px;bottom:20px}.section{padding:64px 0}.kicker{font:700 .78rem ui-monospace,SFMono-Regular,Consolas,monospace;color:var(--cyan);letter-spacing:.12em;text-transform:uppercase}.section h2{font-size:clamp(2rem,4vw,3.1rem);margin:.2em 0 .8em;letter-spacing:-.035em}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.car